#!/bin/sh
# Linux container: reject overlay deletion semantics before packing/copying.
set -eu
root=${1:?expected layer root}
work=$(mktemp "${TMPDIR:-/tmp}/bootkit-additive.XXXXXX")
trap 'rm -f "$work"' 0
trap 'exit 1' HUP INT TERM
find "$root" -type c -exec sh -c '
    for file do
        device=$(stat -c "%t:%T" "$file") || exit 1
        [ "$device" != "0:0" ] || {
            echo "ERROR: whiteout: $file" >&2; exit 1;
        }
    done
' sh {} +
getfattr --dump --no-dereference --match='^(trusted|user)\.overlay\.(opaque|whiteout)$' \
    --recursive "$root" > "$work"
if grep -Eq '^(trusted|user)\.overlay\.(opaque|whiteout)=' "$work"; then
    cat "$work" >&2
    echo 'ERROR: layer must be additive (opaque/whiteout xattr)' >&2
    exit 1
fi
