#!/bin/sh
# shellcheck source=auto/survey/hw-common.sh
. "$(dirname "$0")/hw-common.sh"
command -v lsblk >/dev/null 2>&1 || missing lsblk
BOOT_DISKS=$(boot_disks)
if printf '%s\n' "$BOOT_DISKS" | grep -Fqx '!BOOT-DISK-UNKNOWN'; then
    printf '%s\n' 'N-A: boot disk parent; skipping suggestions and reads for safety'
    exit 0
fi
printf '%s\n' 'CHECK: verify the disk table before using this measured suggestion'
printf '%s\n' 'sdX names may change on boot; also compare by-id.' 'Name | Model | Size GB(integer) | MIN | MAX'
expect=; invalid=0
for disk in $(disks); do
    [ "$(connection "$disk")" != usb ] || continue
    [ "$(read_value "$HW_SYSFS/block/$disk/removable")" = 0 ] || continue
    is_boot "$disk" && continue
    sectors=$(read_value "$HW_SYSFS/block/$disk/size")
    case "$sectors" in ''|*[!0-9]*) printf '%s: N-A: Size\n' "$disk"; invalid=1; continue ;; esac
    gb=$((sectors * 512 / 1000000000))
    min=$((gb * 95 / 100)); max=$(((gb * 105 + 99) / 100))
    model=$(read_value "$HW_SYSFS/block/$disk/device/model")
    token=$(printf '%s\n' "$model" | awk '{print $1}')
    printf '%s | %s | %s | %s | %s\n' "$disk" "$model" "$gb" "$min" "$max"
    ids=
    for id in "${HW_BY_ID:-/dev/disk/by-id}"/*; do
        [ -L "$id" ] || continue
        target=$(readlink -f "$id" 2>/dev/null)
        if [ "${target##*/}" = "$disk" ]; then ids="$ids ${id##*/}"; fi
    done
    printf '  by-id:%s\n' "${ids:- N-A}"
    # guard の区切りとして解釈される型番は、安全な文字列で表現できない。
    case "$token" in ''|N-A|*:*|*,*) printf '%s\n' 'N-A: model usable by guard; suggestion stopped'; invalid=1; continue ;; esac
    expect="${expect}${expect:+,}$disk:$min:$max:$token"
done
if [ -n "$expect" ] && [ "$invalid" = 0 ]; then
    escaped=$(printf '%s' "$expect" | sed "s/'/'\\\\''/g")
    printf "disk-guard.sh --expect '%s'\n" "$escaped"
else
    printf '%s\n' 'No suggestion (no internal disk or insufficient data)'
fi
