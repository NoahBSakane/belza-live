#!/bin/sh
# shellcheck source=auto/survey/hw-common.sh
. "$(dirname "$0")/hw-common.sh"
mb=512
if [ "${1:-}" = --mb ]; then
    [ $# -ge 2 ] || { echo '使い方: hw-disk-speed [--mb N] [デバイス...]' >&2; exit 2; }
    mb=$2; shift 2
fi
case "$mb" in ''|*[!0-9]*) echo 'N は正の整数で指定する' >&2; exit 2 ;; esac
[ "$mb" -gt 0 ] 2>/dev/null && [ "$mb" -le 2147483647 ] 2>/dev/null || exit 2
command -v dd >/dev/null 2>&1 || { missing dd; exit 0; }
command -v lsblk >/dev/null 2>&1 || missing lsblk
BOOT_DISKS=$(boot_disks)
if printf '%s\n' "$BOOT_DISKS" | grep -Fqx '!起動媒体未判定'; then
    printf '%s\n' '未取得: 起動媒体の親ディスク。安全のため対象案・測定を省略'
    exit 0
fi
# マウント元の親が判定できない場合、起動媒体を誤って測らない。
# 分割する値は sysfs のブロック名だけ。
# shellcheck disable=SC2046
if [ $# -eq 0 ]; then set -- $(disks); fi
for arg do
    disk=${arg#/dev/}
    if ! disks | grep -Fqx "$disk"; then printf '%s: 対象外\n' "$arg"; continue; fi
    if is_boot "$disk"; then printf '%s: (起動媒体) 測定対象外\n' "$disk"; continue; fi
    if ! internal_disks | grep -Fqx "$disk"; then
        printf '%s: (USB・取り外し可能媒体) 測定対象外\n' "$disk"; continue
    fi
    if [ "${HW_SPEED_METHOD:-dd}" = hdparm ]; then
        if ! command -v hdparm >/dev/null 2>&1; then missing hdparm; continue; fi
        values=; failed=0
        # shellcheck disable=SC2034
        for pass in 1 2 3; do
            result=$(hdparm -t --direct "/dev/$disk" 2>&1) || { failed=1; break; }
            value=$(printf '%s\n' "$result" | awk '/MB\/sec/ {for(i=2;i<=NF;i++) if($i=="MB/sec" && $(i-1) ~ /^[0-9.]+$/) print $(i-1)}')
            [ -n "$value" ] || { failed=1; break; }
            values="$values $value"
        done
        if [ "$failed" = 1 ]; then printf '%s: 未取得: 読み出しエラー\n' "$disk"; continue; fi
        printf '%s\n' "$values" | awk -v d="$disk" '{
            a=$1; b=$2; c=$3
            if(a>b){t=a;a=b;b=t} if(b>c){t=b;b=c;c=t} if(a>b){t=a;a=b;b=t}
            printf "%s: 中央値 %.2f MB/s (目安: %s; HDD 5400rpm 70〜110 / 7200rpm 100〜130)\n",d,b,(b<40?"不可: 40未満":"可")
        }'
        continue
    fi
    sectors=$(read_value "$HW_SYSFS/block/$disk/size")
    case "$sectors" in ''|*[!0-9]*) printf '%s: 読み出しエラー(容量不明)\n' "$disk"; continue ;; esac
    total=$((sectors / 2048))
    if [ "$total" -lt "$mb" ]; then printf '%s: 読み出しエラー(指定量より小さい)\n' "$disk"; continue; fi
    end=$((total - mb)); middle=$((end / 2))
    values=; failed=0
    for position in 0 "$middle" "$end"; do
        if result=$(dd if="/dev/$disk" of=/dev/null bs=1M iflag=direct skip="$position" count="$mb" 2>&1); then
            bytes=$(printf '%s\n' "$result" | awk '/bytes.*copied/ {print $1; exit}')
            [ "$bytes" = "$((mb * 1048576))" ] || { failed=1; break; }
            speed=$(printf '%s\n' "$result" | awk '/bytes.*copied/ {
                for(i=1;i<=NF;i++) if($i ~ /^s(ec(onds)?)?,?$/ && $(i-1)+0>0) {printf "%.2f",$1/$(i-1)/1e6; exit}
            }')
            if [ -z "$speed" ]; then failed=1; break; fi
            values="$values $speed"
        else failed=1; break; fi
    done
    if [ "$failed" = 1 ]; then printf '%s: 読み出しエラー\n' "$disk"; continue; fi
    printf '%s\n' "$values" | awk -v d="$disk" '{printf "%s: 先頭 %.2f / 中間 %.2f / 末尾 %.2f / 平均 %.2f MB/s\n",d,$1,$2,$3,($1+$2+$3)/3}'
done
