#!/bin/sh
# shellcheck source=auto/survey/hw-common.sh
. "$(dirname "$0")/hw-common.sh"
mb=512
if [ "${1:-}" = --mb ]; then
    [ $# -ge 2 ] || { echo 'Usage: hw-disk-speed [--mb N] [devices...]' >&2; exit 2; }
    mb=$2; shift 2
fi
case "$mb" in ''|*[!0-9]*) echo 'N must be a positive integer' >&2; exit 2 ;; esac
[ "$mb" -gt 0 ] 2>/dev/null && [ "$mb" -le 2147483647 ] 2>/dev/null || exit 2
command -v dd >/dev/null 2>&1 || { missing dd; exit 0; }
command -v lsblk >/dev/null 2>&1 || missing lsblk
BOOT_DISKS=$(boot_disks)
if printf '%s\n' "$BOOT_DISKS" | grep -Fqx '!BOOT-DISK-UNKNOWN'; then
    printf '%s\n' 'N-A: boot disk parent; skipping suggestions and reads for safety'
    exit 0
fi
# マウント元の親が判定できない場合、起動媒体を誤って測らない。
# 分割する値は sysfs のブロック名だけ。
# shellcheck disable=SC2046
if [ $# -eq 0 ]; then set -- $(disks); fi
for arg do
    disk=${arg#/dev/}
    if ! disks | grep -Fqx "$disk"; then printf '%s: excluded\n' "$arg"; continue; fi
    if is_boot "$disk"; then printf '%s: (boot media) read test excluded\n' "$disk"; continue; fi
    if ! internal_disks | grep -Fqx "$disk"; then
        printf '%s: (USB/removable media) read test excluded\n' "$disk"; continue
    fi
    if [ "${HW_SPEED_METHOD:-dd}" = hdparm ]; then
        if ! command -v hdparm >/dev/null 2>&1; then missing hdparm; continue; fi
        values=; failed=0
        # shellcheck disable=SC2034
        for pass in 1 2 3; do
            result=$(hdparm -t --direct "/dev/$disk" 2>&1) || { failed=1; break; }
            value=$(printf '%s\n' "$result" | awk '/MB\/sec/ {for(i=2;i<=NF;i++) if($i=="MB/sec" && $(i-1) ~ /^[0-9.]+$/) print $(i-1)}')
            [ -n "$value" ] || { failed=1; break; }
            values="$values $value"
        done
        if [ "$failed" = 1 ]; then printf '%s: N-A: read error\n' "$disk"; continue; fi
        printf '%s\n' "$values" | awk -v d="$disk" '{
            a=$1; b=$2; c=$3
            if(a>b){t=a;a=b;b=t} if(b>c){t=b;b=c;c=t} if(a>b){t=a;a=b;b=t}
            printf "%s: median %.2f MB/s (HINT: %s; HDD 5400:70-110 / 7200:100-130)\n",d,b,(b<40?"BAD: <40":"FAIR")
        }'
        continue
    fi
    sectors=$(read_value "$HW_SYSFS/block/$disk/size")
    case "$sectors" in ''|*[!0-9]*) printf '%s: read error (size unknown)\n' "$disk"; continue ;; esac
    total=$((sectors / 2048))
    if [ "$total" -lt "$mb" ]; then printf '%s: read error (smaller than requested size)\n' "$disk"; continue; fi
    end=$((total - mb)); middle=$((end / 2))
    values=; failed=0
    for position in 0 "$middle" "$end"; do
        if result=$(dd if="/dev/$disk" of=/dev/null bs=1M iflag=direct skip="$position" count="$mb" 2>&1); then
            bytes=$(printf '%s\n' "$result" | awk '/bytes.*copied/ {print $1; exit}')
            [ "$bytes" = "$((mb * 1048576))" ] || { failed=1; break; }
            speed=$(printf '%s\n' "$result" | awk '/bytes.*copied/ {
                for(i=1;i<=NF;i++) if($i ~ /^s(ec(onds)?)?,?$/ && $(i-1)+0>0) {printf "%.2f",$1/$(i-1)/1e6; exit}
            }')
            if [ -z "$speed" ]; then failed=1; break; fi
            values="$values $speed"
        else failed=1; break; fi
    done
    if [ "$failed" = 1 ]; then printf '%s: read error\n' "$disk"; continue; fi
    printf '%s\n' "$values" | awk -v d="$disk" '{printf "%s: start %.2f / middle %.2f / end %.2f / mean %.2f MB/s\n",d,$1,$2,$3,($1+$2+$3)/3}'
done
