#!/bin/sh
# 電池と AC の状態を読み取る。設定・充放電の操作はしない。
# shellcheck source=auto/survey/hw-common.sh
. "$(dirname "$0")/hw-common.sh"
dir=$HW_SYSFS/class/power_supply

echo "== Battery survey $(date '+%F %T') =="
echo "Kernel: $(read_value "$HW_PROC/sys/kernel/osrelease")"
echo "Model: $(cat "$HW_SYSFS/class/dmi/id/product_name" 2>/dev/null || echo '?') / $(cat "$HW_SYSFS/class/dmi/id/product_version" 2>/dev/null || echo '?')"
echo "BIOS: $(cat "$HW_SYSFS/class/dmi/id/bios_version" 2>/dev/null || echo '?') ($(cat "$HW_SYSFS/class/dmi/id/bios_date" 2>/dev/null || echo '?'))"

echo
echo "== power_supply list =="
ls "$dir" 2>/dev/null || echo "(unreadable: $dir)"

found=0
for bat in "$dir"/BAT*; do
    [ -d "$bat" ] || continue
    found=1
    name=${bat##*/}
    echo
    echo "== $name all fields (uevent) =="
    cat "$bat/uevent" 2>/dev/null || echo "(uevent unreadable)"
    echo
    echo "== $name main fields =="
    for item in manufacturer model_name serial_number technology status capacity cycle_count \
                energy_full energy_full_design energy_now charge_full charge_full_design charge_now \
                voltage_now voltage_min_design current_now power_now temp; do
        if [ -r "$bat/$item" ]; then
            printf '%-20s %s\n' "$item" "$(cat "$bat/$item" 2>/dev/null)"
        else
            printf '%-20s %s\n' "$item" "(missing)"
        fi
    done
    # 健康度 = 満充電容量 / 設計容量。energy_* (µWh) があればそれを、無ければ charge_* (µAh) を使う。
    full=""; design=""; unit=""
    if [ -r "$bat/energy_full" ] && [ -r "$bat/energy_full_design" ]; then
        full=$(cat "$bat/energy_full"); design=$(cat "$bat/energy_full_design"); unit="uWh"
    elif [ -r "$bat/charge_full" ] && [ -r "$bat/charge_full_design" ]; then
        full=$(cat "$bat/charge_full"); design=$(cat "$bat/charge_full_design"); unit="uAh"
    fi
    echo
    if [ -n "$full" ] && [ -n "$design" ] && [ "$design" -gt 0 ] 2>/dev/null; then
        awk -v f="$full" -v d="$design" -v u="$unit" -v n="$name" 'BEGIN {
            h = f / d * 100
            printf "%s health: %.1f%% (full %d %s / design %d %s)\n", n, h, f, u, d, u
            if (u == "uWh") printf "Capacity HINT: full %.1f Wh / design %.1f Wh\n", f/1e6, d/1e6
            if      (h >= 70) v = ">=70%: HINT usable as-is"
            else if (h >= 30) v = "30-70%: calculate shutdown time; verify with a discharge test"
            else              v = "<30%: consider replacement or AC only (external UPS)"
            print "Rating HINT (unsourced thresholds): " v
            if (h < 70) print "WARN: battery health below 70%"
        }'
    else
        echo "$name health: N-A (full/design capacity unreadable)"
    fi
    if [ -r "$bat/cycle_count" ] && [ "$(cat "$bat/cycle_count")" = "0" ]; then
        echo "HINT: cycle_count 0 can mean no data"
    fi
    echo
    echo "== $name charge threshold fields =="
    threshold=0
    for f in "$bat"/charge_control* "$bat"/charge_start* "$bat"/charge_stop* "$bat"/charge_behaviour; do
        [ -e "$f" ] || continue
        threshold=1
        printf '%-28s %s\n' "${f##*/}" "$(cat "$f" 2>/dev/null)"
    done
    [ "$threshold" = 1 ] || echo "(missing: charge threshold control appears unsupported)"
done
[ "$found" = 1 ] || echo "No BAT* found (battery absent or not detected)"

echo
echo "== AC adapter =="
for ac in "$dir"/AC* "$dir"/ADP*; do
    [ -d "$ac" ] || continue
    printf '%s online=%s\n' "${ac##*/}" "$(cat "$ac/online" 2>/dev/null || echo '?')"
done

for tool in "upower -i /org/freedesktop/UPower/devices/battery_BAT0" "acpi -V" "tlp-stat -b"; do
    cmd=${tool%% *}
    echo
    echo "== $tool =="
    if command -v "$cmd" >/dev/null 2>&1; then
        sh -c "$tool" 2>&1 || echo "(failed; tlp-stat may need sudo: sudo $tool)"
    else
        missing "$cmd"
    fi
done
echo
echo "== Done (read only; battery/settings unchanged) =="
