#!/bin/sh
# shellcheck source=auto/survey/hw-common.sh
. "$(dirname "$0")/hw-common.sh"
BOOT_DISKS=$(boot_disks)
if printf '%s\n' "$BOOT_DISKS" | grep -Fqx '!BOOT-DISK-UNKNOWN'; then
    printf '%s\n' 'N-A: boot disk parent'
fi
command -v lsblk >/dev/null 2>&1 || missing lsblk
for disk in $(disks); do
    blk=$HW_SYSFS/block/$disk
    boot=; is_boot "$disk" && boot=' (boot media)'
    printf 'Disk: %s%s\n' "$disk" "$boot"
    smart=$(smart_data "$disk")
    model=$(read_value "$blk/device/model")
    [ "$model" != N-A ] || model=$(read_value "$blk/device/name")
    if [ "$model" = N-A ]; then
        model=$(printf '%s\n' "$smart" | sed -n 's/^Device Model: *//p;s/^Model Number: *//p;s/^Product: *//p' | head -n 1)
        model=${model:-N-A}
    fi
    serial=$(read_value "$blk/device/serial")
    if [ "$serial" = N-A ]; then
        serial=$(printf '%s\n' "$smart" | sed -n 's/^Serial [Nn]umber: *//p' | head -n 1)
        serial=${serial:-N-A}
    fi
    printf 'Model: %s\nSerial: %s\nSize: %s\n' "$model" "$serial" "$(capacity "$disk")"
    conn=$(connection "$disk")
    link=$(printf '%s\n' "$smart" | sata_link); link=${link:-N-A}
    health=$(printf '%s\n' "$smart" | smart_health)
    printf 'Rotational: %s\nConnection: %s\nremovable: %s\nRead-only: %s\nSATA link: %s\nSMART health: %s\n' \
        "$(read_value "$blk/queue/rotational")" "$conn" "$(read_value "$blk/removable")" "$(read_value "$blk/ro")" "$link" "$health"
    printf '%s\n' "$smart" | smart_attributes
    # NVMe の情報も原単位のまま残す。ATA の 241/242 の単位も機種に依存する。
    printf '%s\n' "$smart" | awk '/^(Power On Hours|Percentage Used|Data Units Written|Data Units Read|Temperature|Media and Data Integrity Errors):/ {print "NVMe " $0}'
    hours=$(printf '%s\n' "$smart" | awk '$1==9 && $3 ~ /^0x/ {print $10; exit} /^Power On Hours:/ {sub(/^.*: */, ""); print; exit}')
    printf 'Power-on hours: %s\n' "${hours:-N-A}"
    attention=$(printf '%s\n' "$smart" | awk '$3 ~ /^0x/ && ($1==5||$1==187||$1==197||$1==198||$1==199) && $10+0!=0 {printf "%s=%s ",$1,$10}
        /^Media and Data Integrity Errors:/ {v=$0; sub(/^.*: */,"",v); gsub(/,/,"",v); if(v+0>0) printf "NVMe-uncorrectable=%s ",v}')
    [ "$health" = PASSED ] || attention="$attention SMART=$health"
    [ "$link" != '1.5Gb/s' ] || attention="$attention SATA-slow"
    printf '%s\n' "$smart" | grep -q 'N-A:' && printf '%s\n' "$smart"
    if ! printf '%s\n' "$smart" | grep -Eq 'SMART overall-health|SMART Health Status:'; then
        printf '%s\n' 'N-A: SMART data (CHECK support/permissions/adapter)'
    fi
    printf 'WARN: %s\n\n' "${attention:-none}"
done
