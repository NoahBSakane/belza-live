#!/bin/sh
# shellcheck source=auto/survey/hw-common.sh
. "$(dirname "$0")/hw-common.sh"
scripts=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
out=; speed=0; mb=512; allow_disk=0
while [ $# -gt 0 ]; do
    case "$1" in
        --out|--mb)
            [ $# -ge 2 ] || { echo 'Missing option value' >&2; exit 2; }
            if [ "$1" = --out ]; then out=$2; else mb=$2; fi; shift 2 ;;
        --speed) speed=1; shift ;;
        --allow-disk) allow_disk=1; shift ;;
        *) echo 'Usage: hw-survey [--out DIR] [--speed] [--mb N] [--allow-disk]' >&2; exit 2 ;;
    esac
done
case "$mb" in ''|*[!0-9]*) echo 'N must be a positive integer' >&2; exit 2 ;; esac
[ "$mb" -gt 0 ] 2>/dev/null && [ "$mb" -le 2147483647 ] 2>/dev/null || exit 2
out=${out:-/tmp/hw-survey-$(date '+%Y%m%d-%H%M%S')}
# 存在する最も近い親で、作成前にファイルシステムを調べる。
case "$out" in /*) ;; *) out=$PWD/$out ;; esac
case "$out/" in */../*|*/./*) echo 'Output path must not contain . or ..' >&2; exit 2 ;; esac
parent=$out
while [ ! -e "$parent" ]; do parent=$(dirname "$parent"); done
if command -v findmnt >/dev/null 2>&1; then
    fs=$(findmnt -n -o FSTYPE -T "$parent" 2>/dev/null)
else missing findmnt; fs=N-A; fi
case "$fs" in
    tmpfs|ramfs|overlay) ;;
    *)
        printf 'WARN: would write to disk (path: %s, type: %s); --allow-disk required\n' "$out" "${fs:-N-A}" >&2
        [ "$allow_disk" = 1 ] || exit 1 ;;
esac
# 既存ログ・シンボリックリンクを上書きしない。
if [ -e "$out" ] || [ -L "$out" ]; then echo 'Output already exists; choose a new DIR' >&2; exit 1; fi
(umask 077; mkdir -p "$out") || exit 1
for tool in hw-system hw-disks hw-ports hw-battery disk-guard-suggest; do
    if ! "$scripts/$tool" > "$out/$tool.txt" 2>&1; then
        printf 'N-A: %s failed\n' "$tool" >> "$out/$tool.txt"
    fi
done
if [ "$speed" = 1 ]; then
    "$scripts/hw-disk-speed" --mb "$mb" > "$out/hw-disk-speed.txt" 2>&1 || printf '%s\n' 'N-A: speed test failed' >> "$out/hw-disk-speed.txt"
fi
# 要約は取得済みのログから作る(SMART を二重に問い合わせない)。
{
    printf '%s\n' '== Hardware survey (! = WARN; see logs for details) =='
    grep -E '^(Model:|BIOS:|CPU:|Memory:)' "$out/hw-system.txt"
    awk '
        function emit() {
            if(d=="") return
            tail=serial=="N-A"?serial:substr(serial,length(serial)>6?length(serial)-5:1)
            mark=""; if (attention != "none") mark=" !" attention
            printf "%s %s SN-tail:%s %s %s %s\n",d,model,tail,size,conn,link
            printf "  SMART:%s%s hours:%s\n",health,mark,hours
        }
        /^Disk:/ {emit(); d=$0; sub(/^Disk: /,"",d)}
        /^Model:/ {model=$0; sub(/^[^:]*: /,"",model)}
        /^Serial:/ {serial=$0; sub(/^[^:]*: /,"",serial)}
        /^Size:/ {size=$0; sub(/^[^:]*: /,"",size); sub(/ \/.*/,"",size)}
        /^Connection:/ {conn=$0; sub(/^[^:]*: /,"",conn)}
        /^SATA link:/ {link=$0; sub(/^[^:]*: /,"",link)}
        /^SMART health:/ {health=$0; sub(/^[^:]*: /,"",health)}
        /^Power-on hours:/ {hours=$0; sub(/^[^:]*: /,"",hours)}
        /^WARN:/ {attention=$0; sub(/^[^:]*: /,"",attention)}
        END {emit()}' "$out/hw-disks.txt"
    if [ "$speed" = 1 ]; then cat "$out/hw-disk-speed.txt"; fi
    grep '^NIC ' "$out/hw-ports.txt"
    grep -E 'health:|^WARN:|^BAT\*| online=' "$out/hw-battery.txt"
} > "$out/summary-body.txt"
{
    awk 'NR<=36 {print} END {if(NR>36) printf "See logs for %d more lines\n",NR-36}' "$out/summary-body.txt"
    awk '/^disk-guard.sh --expect / {
        if(length($0)>80) print "disk-guard.sh --expect: see disk-guard-suggest.txt for full command"
        else print
    } /^No suggestion/ {print}' "$out/disk-guard-suggest.txt"
    printf '%s\n' 'CHECK: verify the detailed disk table before using this suggestion'
    printf 'Output: %s\n' "$out"
} | summary_width > "$out/summary.txt"
cat "$out/summary.txt"
