#!/bin/sh
# live-build の設定。Debian 13(trixie)。
#   ARCH:   amd64(既定)か arm64
#   FLAVOR: cli(既定。診断ツール + インストーラー)
#           lxqt(cli に、LXQt のデスクトップと Calamares を足したもの)
#           icewm(cli に、軽量な IceWM のデスクトップを足したもの。tty1 で自動ログイン後に X を起動。起動オプション nox で CLI のまま)
#   amd64: syslinux(Legacy BIOS)と grub-efi(UEFI)の iso-hybrid
#   arm64: grub-efi(UEFI)の iso-hybrid(arm64 の PC・仮想マシンは UEFI 起動)
# Live(診断環境)と Debian Installer の両方の起動メニューを持つ。インストーラーは、既定では何も消さない(preseed なし)。
set -e
ARCH="${ARCH:-amd64}"
FLAVOR="${FLAVOR:-cli}"
rm -f config/package-lists/lxqt.list.chroot config/package-lists/icewm.list.chroot
rm -f config/hooks/live/0200-icewm-keys.hook.chroot
rm -rf config/includes.chroot
mkdir -p config/includes.chroot/usr/local/bin
cp auto/survey/* config/includes.chroot/usr/local/bin/
chmod +x config/includes.chroot/usr/local/bin/*
case "$FLAVOR" in
	cli) ;;
	lxqt)
		mkdir -p config/package-lists
		printf '%s\n' live-task-lxqt calamares calamares-settings-debian gparted > config/package-lists/lxqt.list.chroot
		;;
	icewm)
		mkdir -p config/package-lists config/hooks/live \
			config/includes.chroot/etc/skel/.config/autostart \
			config/includes.chroot/usr/local/bin
		printf '%s\n' xserver-xorg-core xserver-xorg-input-libinput xserver-xorg-video-all xinit \
			icewm pcmanfm lxterminal gparted network-manager wpasupplicant fonts-noto-cjk xdg-utils x11-xkb-utils kbd \
			fcitx5 fcitx5-mozc fcitx5-frontend-gtk3 fcitx5-frontend-qt5 im-config \
			> config/package-lists/icewm.list.chroot
		cat > config/includes.chroot/etc/skel/.xinitrc <<'EOF'
# 入力用の環境だけを継承させる。Fcitx5 本体は ime-on で起動する。
export GTK_IM_MODULE=fcitx QT_IM_MODULE=fcitx XMODIFIERS=@im=fcitx
exec icewm-session
EOF
		# デスクトップの自動起動からも Fcitx5 を起動しない。
		cat > config/includes.chroot/etc/skel/.config/autostart/org.fcitx.Fcitx5.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Fcitx 5
Hidden=true
EOF
		cat > config/includes.chroot/usr/local/bin/kbd-toggle <<'EOF'
#!/bin/sh
set -e
if [ -n "${DISPLAY:-}" ]; then
    current=$(setxkbmap -query | awk '$1 == "layout:" { print $2 }')
    case "$current" in
        us) layout=jp ;;
        *) layout=us ;;
    esac
    setxkbmap -layout "$layout"
else
    # コンソールは配列名を取得できないため、最後の切り替えを記録する。
    state_dir=${XDG_STATE_HOME:-$HOME/.local/state}
    state_file=$state_dir/kbd-toggle-console
    current=jp
    if [ -r /etc/default/keyboard ]; then
        current=$(sed -n 's/^XKBLAYOUT="\([^" ]*\)"/\1/p' /etc/default/keyboard)
    fi
    if [ -r "$state_file" ]; then
        IFS= read -r current < "$state_file"
    fi
    case "$current" in
        us) layout=jp; keymap=jp106 ;;
        *) layout=us; keymap=us ;;
    esac
    loadkeys "$keymap" >/dev/null
    mkdir -p "$state_dir"
    printf '%s\n' "$layout" > "$state_file"
fi
printf '%s\n' "$layout"
EOF
		cat > config/includes.chroot/usr/local/bin/ime-on <<'EOF'
#!/bin/sh
set -e
export GTK_IM_MODULE=fcitx QT_IM_MODULE=fcitx XMODIFIERS=@im=fcitx
fcitx5 -d
printf '%s\n' 'このあとに起動するアプリで日本語入力が使える'
EOF
		cat > config/hooks/live/0200-icewm-keys.hook.chroot <<'EOF'
#!/bin/sh
set -e
mkdir -p "/etc/skel/.icewm"
if [ -f "/usr/share/icewm/keys" ]; then
    cp "/usr/share/icewm/keys" "/etc/skel/.icewm/keys"
else
    printf '%s\n' 'WARNING: /usr/share/icewm/keys がないため、追加のキー割り当てだけを設定します。' >&2
    : > "/etc/skel/.icewm/keys"
fi
for binding in 'key "Ctrl+Alt+K" /usr/local/bin/kbd-toggle' \
    'key "Ctrl+Alt+J" /usr/local/bin/ime-on'; do
    if ! grep -Fqx -- "$binding" "/etc/skel/.icewm/keys"; then
        printf '%s\n' "$binding" >> "/etc/skel/.icewm/keys"
    fi
done
EOF
		chmod +x config/hooks/live/0200-icewm-keys.hook.chroot \
			config/includes.chroot/usr/local/bin/kbd-toggle \
			config/includes.chroot/usr/local/bin/ime-on
		# 生成先のログイン時に変数を展開する。
		# shellcheck disable=SC2016
		printf '%s\n' \
			'[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"' \
			'# tty1 の自動ログイン後に X を起動する。起動オプションに nox があるときは、CLI のまま(あとで startx で起動できる)。' \
			'if [ -z "$DISPLAY" ] && [ "$(tty)" = /dev/tty1 ] && ! grep -qw nox /proc/cmdline; then exec startx; fi' \
			> config/includes.chroot/etc/skel/.bash_profile
		;;
	*) echo "unsupported FLAVOR: $FLAVOR" >&2; exit 1 ;;
esac
# forky は hook 内だけで有効にし、live-build の取得元には常設しない。
mkdir -p config/hooks/live
{
    printf '%s\n' '#!/bin/sh' 'set -e'
    printf 'set --'
    while IFS= read -r package; do
        case "$package" in
            ''|\#*) continue ;;
            *[!a-z0-9+.-]*) echo "invalid forky package: $package" >&2; exit 1 ;;
        esac
        printf ' %s' "$package"
    done < config/forky-packages.txt
    printf '\n'
    cat auto/forky-hook.sh
} > config/hooks/live/0400-forky-clonezilla.hook.chroot
chmod +x config/hooks/live/0400-forky-clonezilla.hook.chroot
# ネットワーク関連の既定動作は全フレーバーで共通。
mkdir -p config/hooks/live config/includes.chroot/usr/local/bin
cat > config/hooks/live/0100-no-modemmanager.hook.chroot <<'EOF'
#!/bin/sh
# 不在・削除失敗でもビルドを続ける。
apt-get purge -y modemmanager || :
apt-get autoremove -y || :
EOF
cat > config/hooks/live/0300-ssh-off.hook.chroot <<'EOF'
#!/bin/sh
# 無効化に失敗してもビルドを続ける。手動で起動できるよう mask はしない。
systemctl disable ssh.service || :
if systemctl cat ssh.socket >/dev/null 2>&1; then
    systemctl disable ssh.socket || :
fi
EOF
cat > config/includes.chroot/usr/local/bin/ssh-on <<'EOF'
#!/bin/sh
set -e
printf '%s\n' 'SSH を起動する。LAN から、user でログインできるようになる。先にパスワードを変更する'
if [ "$(id -u)" = 0 ]; then
    passwd user
else
    passwd
fi
sudo systemctl start ssh
ip -brief address
EOF
chmod +x config/hooks/live/0100-no-modemmanager.hook.chroot \
    config/hooks/live/0300-ssh-off.hook.chroot \
    config/includes.chroot/usr/local/bin/ssh-on
# includes.chroot はフレーバーを切り替えるたびに作り直す。安全モードは共通。
mkdir -p config/includes.chroot/etc/initramfs-tools/scripts/init-top \
	config/includes.chroot/etc/initramfs-tools/hooks
cp auto/bootkit-safe config/includes.chroot/etc/initramfs-tools/scripts/init-top/bootkit-safe
cp auto/bootkit-safe-hook config/includes.chroot/etc/initramfs-tools/hooks/bootkit-safe
chmod +x config/includes.chroot/etc/initramfs-tools/scripts/init-top/bootkit-safe \
	config/includes.chroot/etc/initramfs-tools/hooks/bootkit-safe
case "$ARCH" in
	amd64) BOOTLOADERS="syslinux,grub-efi"; MEMTEST="memtest86+" ;;
	arm64) BOOTLOADERS="grub-efi"; MEMTEST="none" ;;
	*) echo "unsupported ARCH: $ARCH" >&2; exit 1 ;;
esac
lb config noauto \
	--mode debian \
	--distribution trixie \
	--architectures "$ARCH" \
	--linux-flavours "$ARCH" \
	--archive-areas "main contrib non-free-firmware" \
	--binary-images iso-hybrid \
	--bootloaders "$BOOTLOADERS" \
	--debian-installer live \
	--debian-installer-distribution trixie \
	--debian-installer-gui false \
	--memtest "$MEMTEST" \
	--firmware-chroot true \
	--firmware-binary true \
	--iso-application "bootkit-linux" \
	--iso-publisher "NoahBSakane" \
	--iso-volume "BOOTKIT-LINUX-$ARCH-$FLAVOR" \
	--bootappend-live "boot=live components quiet locales=en_US.UTF-8 keyboard-layouts=jp timezone=Asia/Tokyo" \
	"${@}"
