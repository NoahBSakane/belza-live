#!/bin/sh
# live-build の設定。Debian 13(trixie)。
#   ARCH:   amd64(既定)か arm64
#   cli 基本層と icewm / lxqt 差分層を、起動メニューで選ぶ。
#   amd64: syslinux(Legacy BIOS)と grub-efi(UEFI)の iso-hybrid
#   arm64: grub-efi(UEFI)の iso-hybrid(arm64 の PC・仮想マシンは UEFI 起動)
# Live(診断環境)と Debian Installer の両方の起動メニューを持つ。インストーラーは、既定では何も消さない(preseed なし)。
set -e
ARCH="${ARCH:-amd64}"
[ -z "${FLAVOR:-}" ] || { echo "FLAVOR is obsolete; select module at boot" >&2; exit 1; }
rm -f config/package-lists/lxqt.list.chroot config/package-lists/icewm.list.chroot
rm -f config/hooks/live/0200-icewm-keys.hook.chroot
rm -rf config/includes.chroot
mkdir -p config/includes.chroot/usr/local/bin
cp -R auto/survey/. config/includes.chroot/usr/local/bin/
find config/includes.chroot/usr/local/bin -type f -exec chmod +x {} \;
sh auto/flavor cli
# forky は hook 内だけで有効にし、live-build の取得元には常設しない。
mkdir -p config/hooks/live
{
    printf '%s\n' '#!/bin/sh' 'set -e'
    printf 'set --'
    while IFS= read -r package; do
        case "$package" in
            ''|\#*) continue ;;
            *[!a-z0-9+.-]*) echo "invalid forky package: $package" >&2; exit 1 ;;
        esac
        printf ' %s' "$package"
    done < config/forky-packages.txt
    printf '\n'
    cat auto/forky-hook.sh
} > config/hooks/live/0400-forky-clonezilla.hook.chroot
chmod +x config/hooks/live/0400-forky-clonezilla.hook.chroot
# ネットワーク関連の既定動作は全フレーバーで共通。
mkdir -p config/hooks/live config/includes.chroot/usr/local/bin
cat > config/hooks/live/0100-no-modemmanager.hook.chroot <<'EOF'
#!/bin/sh
# 不在・削除失敗でもビルドを続ける。
apt-get purge -y modemmanager || :
apt-get autoremove -y || :
EOF
cat > config/hooks/live/0300-ssh-off.hook.chroot <<'EOF'
#!/bin/sh
# 無効化に失敗してもビルドを続ける。手動で起動できるよう mask はしない。
systemctl disable ssh.service || :
if systemctl cat ssh.socket >/dev/null 2>&1; then
    systemctl disable ssh.socket || :
fi
EOF
cat > config/includes.chroot/usr/local/bin/ssh-on <<'EOF'
#!/bin/sh
set -e
printf '%s\n' 'SSH を起動する。LAN から、user でログインできるようになる。先にパスワードを変更する'
if [ "$(id -u)" = 0 ]; then
    passwd user
else
    passwd
fi
sudo systemctl start ssh
ip -brief address
EOF
chmod +x config/hooks/live/0100-no-modemmanager.hook.chroot \
    config/hooks/live/0300-ssh-off.hook.chroot \
    config/includes.chroot/usr/local/bin/ssh-on
# includes.chroot はフレーバーを切り替えるたびに作り直す。安全モードは共通。
mkdir -p config/includes.chroot/etc/initramfs-tools/scripts/init-top \
	config/includes.chroot/etc/initramfs-tools/hooks
cp auto/bootkit-safe config/includes.chroot/etc/initramfs-tools/scripts/init-top/bootkit-safe
cp auto/bootkit-safe-hook config/includes.chroot/etc/initramfs-tools/hooks/bootkit-safe
chmod +x config/includes.chroot/etc/initramfs-tools/scripts/init-top/bootkit-safe \
	config/includes.chroot/etc/initramfs-tools/hooks/bootkit-safe
case "$ARCH" in
	amd64) BOOTLOADERS="syslinux,grub-efi"; MEMTEST="memtest86+" ;;
	arm64) BOOTLOADERS="grub-efi"; MEMTEST="none" ;;
	*) echo "unsupported ARCH: $ARCH" >&2; exit 1 ;;
esac
# 切り替え時は前の自動検査項目を消し、amd64 だけに再生成する。
for menu in config/bootloaders/grub-pc/grub.cfg config/bootloaders/syslinux_common/live.cfg.in; do
    awk -v arch="$ARCH" -v menu="$menu" '
        /^# BEGIN BOOTKIT SURVEY$/ {
            print
            if (arch == "amd64") {
                file = menu ~ /grub.cfg$/ ? "auto/survey-grub.cfg" : "auto/survey-syslinux.cfg"
                while ((getline line < file) > 0) print line
                close(file)
            }
            skip = 1; next
        }
        /^# END BOOTKIT SURVEY$/ { skip = 0 }
        !skip { print }
    ' "$menu" > "$menu.new"
    mv "$menu.new" "$menu"
done
if [ "$ARCH" = amd64 ]; then
    mkdir -p config/includes.chroot/etc/systemd/system/multi-user.target.wants
    mkdir -p config/includes.chroot/etc/systemd/system/getty@tty1.service.d
    printf '%s\n' '[Unit]' 'ConditionKernelCommandLine=!bootkit.survey' > config/includes.chroot/etc/systemd/system/getty@tty1.service.d/survey.conf
    cp auto/bootkit-survey.service config/includes.chroot/etc/systemd/system/
    cp auto/bootkit-survey-session config/includes.chroot/usr/local/bin/
    chmod +x config/includes.chroot/usr/local/bin/bootkit-survey-session
    ln -s ../bootkit-survey.service config/includes.chroot/etc/systemd/system/multi-user.target.wants/bootkit-survey.service
fi
lb config noauto \
	--mode debian \
	--distribution trixie \
	--architectures "$ARCH" \
	--linux-flavours "$ARCH" \
	--archive-areas "main contrib non-free-firmware" \
	--binary-images iso-hybrid \
	--bootloaders "$BOOTLOADERS" \
	--debian-installer live \
	--debian-installer-distribution trixie \
	--debian-installer-gui false \
	--memtest "$MEMTEST" \
	--firmware-chroot true \
	--firmware-binary true \
	--iso-application "bootkit-linux" \
	--iso-publisher "NoahBSakane" \
	--iso-volume "BOOTKIT-LINUX-$ARCH" \
	--bootappend-live "boot=live components quiet locales=en_US.UTF-8 keyboard-layouts=jp timezone=Asia/Tokyo" \
	"${@}"
