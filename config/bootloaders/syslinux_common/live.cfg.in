label live-@FLAVOUR@
	menu label ^Live system (@FLAVOUR@)
	menu default
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@

label live-@FLAVOUR@-failsafe
	menu label Live system (@FLAVOUR@ fail-safe mode)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE_FAILSAFE@

label live-@FLAVOUR@-toram
	menu label Live system, copy to RAM
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ toram

label live-@FLAVOUR@-safe
	menu label Live system, safe mode
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ bootkit.safe=1

# BEGIN BOOTKIT SURVEY
label live-@FLAVOUR@-survey-edge14-0578
	menu label Hardware survey: ThinkPad Edge 14 (0578), auto
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ bootkit.safe=1 bootkit.survey=edge14-0578

label live-@FLAVOUR@-survey-g560
	menu label Hardware survey: Lenovo G560, auto
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ bootkit.safe=1 bootkit.survey=g560

label live-@FLAVOUR@-survey-generic
	menu label Hardware survey: other PC, auto (generic)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ bootkit.safe=1 bootkit.survey=generic
# END BOOTKIT SURVEY
